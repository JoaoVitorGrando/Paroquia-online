APP_NAME="Paróquia Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paroquia_online
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# === Configuração de e-mail (US015 - Sprint 3) ===
# Para envio real de e-mail no formulário de contato, configure um SMTP válido.
# Exemplo para Gmail App Password ou Mailtrap.
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="nao-responda@paroquia.com"
MAIL_FROM_NAME="${APP_NAME}"
PAROQUIA_EMAIL_DESTINO=contato@paroquia.com
